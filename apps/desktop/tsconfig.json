{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@desktop/link-title-client": ["./src/lib/link-title-client.full.ts"],
      "@desktop/bot-setup-overlay": ["./src/app/bot-product/setup-overlay.tsx"],
      "@desktop/boot-failure-overlay": ["./src/components/boot-failure-overlay.tsx"],
      "@desktop/install-overlay": ["./src/components/desktop-install-overlay.tsx"],
      "@desktop/i18n-catalog": ["./src/i18n/catalog.ts"],
      "@desktop/i18n-ssh-english": ["./src/i18n/en.ts"],
      "@desktop/integration-store": ["./src/app/right-sidebar/store.full.ts"],
      "@desktop/integration-surfaces": ["./src/app/contrib/integration-surfaces.full.tsx"],
      "@desktop/sdk-integration-host": ["./src/sdk/integration-host.full.ts"],
      "@desktop/settings": ["./src/app/settings/index.tsx"],
      "@bot-mode/plugin": ["./src/plugins/hermes-bots/legacy-plugin.js"],
      "@hermes/plugin-sdk": ["./src/sdk/index.ts"],
      "@hermes/shared/billing": ["../shared/src/billing-types.ts"],
      "@hermes/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src", "../shared/src"],
  "exclude": ["e2e", "electron", "playwright.config.ts"],
  "references": [{ "path": "./tsconfig.electron.json" }]
}
