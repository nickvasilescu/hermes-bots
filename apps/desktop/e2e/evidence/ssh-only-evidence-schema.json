{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickvasilescu/hermes-bots/schemas/ssh-only-evidence-v1.json",
  "title": "Korgo Linux SSH-only cutover evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "reviewedGitSha",
    "artifact",
    "gates",
    "redactionConfirmed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "reviewedGitSha": { "$ref": "#/$defs/gitSha" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "electronVersion", "sourceBuild", "fixedInputs"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "electronVersion": { "const": "43.4.1" },
        "sourceBuild": { "const": true },
        "fixedInputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["electronArchive", "electronHeaders"],
          "properties": {
            "electronArchive": { "$ref": "#/$defs/sriSha256" },
            "electronHeaders": { "$ref": "#/$defs/sriSha256" }
          }
        },
        "linuxUnpackedSha256": { "$ref": "#/$defs/sha256" },
        "appImageSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["g0", "g1", "g2", "g3", "g4", "g5", "g6", "g7"],
      "properties": {
        "g0": {
          "allOf": [{ "$ref": "#/$defs/automatedGate" }],
          "unevaluatedProperties": false
        },
        "g1": {
          "allOf": [{ "$ref": "#/$defs/automatedGate" }],
          "unevaluatedProperties": false
        },
        "g2": {
          "allOf": [{ "$ref": "#/$defs/automatedGate" }],
          "unevaluatedProperties": false
        },
        "g3": {
          "allOf": [
            { "$ref": "#/$defs/automatedGate" },
            {
              "type": "object",
              "required": ["dummyInputsOnly", "ipControlsEnforced", "readDenialMatrix", "networkMatrix"],
              "properties": {
                "dummyInputsOnly": { "const": true },
                "ipControlsEnforced": { "const": true },
                "readDenialMatrix": { "type": "string", "minLength": 1 },
                "networkMatrix": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "g4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "decision",
            "carterSignOff",
            "reviewer",
            "reviewedAt",
            "reviewedGitSha",
            "artifactSha256",
            "criticalOpen",
            "otherHighOpen",
            "transientRendererCredentialDisposition"
          ],
          "properties": {
            "status": { "const": "passed" },
            "decision": { "enum": ["ACCEPT-INCREMENTAL", "REQUIRE-PROXY"] },
            "carterSignOff": { "const": true },
            "reviewer": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "format": "date-time" },
            "reviewedGitSha": { "$ref": "#/$defs/gitSha" },
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "criticalOpen": { "const": 0 },
            "otherHighOpen": { "const": 0 },
            "transientRendererCredentialDisposition": {
              "enum": ["accepted-high-residual", "main-process-proxy-reviewed"]
            },
            "proxyReviewedGitSha": { "$ref": "#/$defs/gitSha" },
            "notes": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "decision": { "const": "ACCEPT-INCREMENTAL" } } },
              "then": {
                "properties": {
                  "transientRendererCredentialDisposition": { "const": "accepted-high-residual" }
                }
              }
            },
            {
              "if": { "properties": { "decision": { "const": "REQUIRE-PROXY" } } },
              "then": {
                "required": ["proxyReviewedGitSha"],
                "properties": {
                  "transientRendererCredentialDisposition": { "const": "main-process-proxy-reviewed" }
                }
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "g5": {
          "allOf": [
            { "$ref": "#/$defs/automatedGate" },
            {
              "type": "object",
              "required": ["nonAuthoritativeState", "hermesVersion", "hermesCommit", "schemaVersion", "observations"],
              "properties": {
                "nonAuthoritativeState": { "const": true },
                "hermesVersion": { "const": "0.20.4" },
                "hermesCommit": { "const": "c820a5d38321a8d870e5b1ed0d89f8b933dd48e8" },
                "schemaVersion": { "const": 26 },
                "observations": {
                  "type": "array",
                  "minItems": 8,
                  "items": { "$ref": "#/$defs/observation" }
                }
              }
            }
          ]
        },
        "g6": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "carterApproval", "approvedAt", "artifactSha256", "hostFingerprint", "g4Decision", "g5EvidenceSha256"],
          "properties": {
            "status": { "const": "approved" },
            "carterApproval": { "const": true },
            "approvedAt": { "type": "string", "format": "date-time" },
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "hostFingerprint": { "$ref": "#/$defs/fingerprint" },
            "g4Decision": { "enum": ["ACCEPT-INCREMENTAL", "REQUIRE-PROXY"] },
            "g5EvidenceSha256": { "$ref": "#/$defs/sha256" },
            "notes": { "type": "string" }
          }
        },
        "g7": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observationDays", "observations", "rollbackAssetsRetained"],
          "properties": {
            "status": { "enum": ["pending", "observing", "passed", "failed"] },
            "observationDays": { "type": "integer", "minimum": 0, "maximum": 7 },
            "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
            "rollbackAssetsRetained": { "const": true }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "passed" } } },
              "then": { "properties": { "observationDays": { "const": 7 } } }
            }
          ]
        }
      }
    },
    "redactionConfirmed": { "const": true }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sriSha256": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$" },
    "fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
    "automatedGate": {
      "type": "object",
      "required": ["status", "commands", "evidenceSha256"],
      "properties": {
        "status": { "const": "passed" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "notes": { "type": "string" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "evidenceSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail"] },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "notes": { "type": "string" }
      }
    }
  }
}
